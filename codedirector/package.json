{
  "name": "codedirector",
  "version": "0.2.0",
  "description": "Contract/verification layer around coding agents: structural index, blast radius, Vibe Check, scope enforcement, evidence-classed change reports.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "cdir": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "eval": "npm run build && node dist/eval/run.js",
    "cdir": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.24.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
